rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function memberDoc(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data;
    }
    function member(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid))
        && memberDoc(teamId).active == true;
    }
    function admin(teamId) {
      return member(teamId) && memberDoc(teamId).role == 'Administrator';
    }
    // Employees may only use shops listed on their member record.
    // Records with no shop field belong to the "main" shop.
    function inMyShop(teamId, shopId) {
      return admin(teamId)
        || (member(teamId)
            && memberDoc(teamId).shops is list
            && shopId in memberDoc(teamId).shops)
        || (member(teamId)
            && !(memberDoc(teamId).shops is list)
            && shopId == 'main');
    }
    function recordShop(data) {
      return ('shop' in data) ? data.shop : 'main';
    }

    match /teams/{teamId} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if member(teamId) || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if admin(teamId);

      match /members/{uid} {
        // Allows the creator to add only their own initial administrator record.
        allow create: if signedIn() && uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid
          && request.resource.data.role == 'Administrator';
        // Active administrators can add other team members.
        allow create: if admin(teamId);
        allow read: if signedIn() && (uid == request.auth.uid || admin(teamId));
        allow update, delete: if admin(teamId);
      }

      // Shops: everyone in the team can read the list; only admins change it.
      match /shops/{shopId} {
        allow read: if member(teamId);
        allow create, update, delete: if admin(teamId);
      }

      // Audit trail: employees can write their own entries but never read them.
      match /audit/{docId} {
        allow read: if admin(teamId);
        allow create: if member(teamId) && inMyShop(teamId, recordShop(request.resource.data));
        allow update, delete: if admin(teamId);
      }

      // Business records are limited to the employee's own shop.
      match /{collection}/{docId} {
        allow read, delete: if collection in ['items', 'stockin', 'sales', 'tx', 'exp']
          && inMyShop(teamId, recordShop(resource.data));
        allow create, update: if collection in ['items', 'stockin', 'sales', 'tx', 'exp']
          && inMyShop(teamId, recordShop(request.resource.data));
        // Legacy 'users' collection: administrators only.
        allow read, write: if collection == 'users' && admin(teamId);
      }
    }
  }
}